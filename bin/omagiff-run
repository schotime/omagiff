#!/bin/bash
# Run giff correctly on Omarchy. This is what the floating window runs, and it
# also works inline in a normal terminal.

HOLD=0
RETURN_TO=""
while :; do
  case "${1:-}" in
    --omagiff-window) HOLD=1; shift ;;
    --omagiff-return) RETURN_TO="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done

# Making giff a full-width column scrolls the whole scrolling tape, pushing the
# terminal that launched it off-screen. Hyprland then picks whichever column the
# tape happens to leave in view, which is rarely the one you came from. Focusing
# the launching window by address puts it back and scrolls the tape to it.
# This Hyprland parses `hyprctl dispatch` arguments as Lua, so the legacy
# `focuswindow address:...` form is a syntax error. Try the Lua API first and
# fall back, the way omarchy-launch-about does for its own dispatches.
#
# The scrolling layout only scrolls to a newly focused window when at least
# scrolling:follow_min_visible of it is already on screen (0.4 by default).
# A full-width giff column pushes the launching terminal almost entirely out of
# view, well under that, so focusing it would otherwise leave you typing into a
# window you cannot see. Drop the threshold for this one dispatch and put it
# straight back.
return_focus() {
  [[ -n $RETURN_TO ]] || return 0

  local threshold=""
  threshold=$(hyprctl getoption scrolling:follow_min_visible 2>/dev/null | awk '/^float:/ {print $2}')
  if [[ $threshold =~ ^[0-9.]+$ ]]; then
    trap 'hyprctl keyword scrolling:follow_min_visible "$threshold" >/dev/null 2>&1' RETURN
    hyprctl keyword scrolling:follow_min_visible 0 >/dev/null 2>&1
  fi

  hyprctl dispatch "hl.dsp.focus({ window = \"address:$RETURN_TO\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$RETURN_TO" >/dev/null 2>&1 || true
}

# Omarchy sets diff.mnemonicPrefix=true globally, which makes `git diff` emit
# i/ and w/ path prefixes. giff's parser only matches a/ and b/, so without this
# override it reports "No changes." in every repo. Scoped to giff's own git
# calls via git's environment config, so normal `git diff` output is untouched.
i="${GIT_CONFIG_COUNT:-0}"
export GIT_CONFIG_KEY_$i=diff.mnemonicPrefix
export GIT_CONFIG_VALUE_$i=false
export GIT_CONFIG_COUNT=$((i + 1))

# uwsm/xdg-terminal-exec inherits the systemd user PATH, which does not include
# ~/.cargo/bin (that is only added for interactive shells in ~/.bashrc), so the
# floating window would not find giff without this.
command -v giff >/dev/null 2>&1 || PATH="$HOME/.cargo/bin:$PATH"

# Anything printed before giff takes over the screen would otherwise vanish with
# the window the instant giff exits.
bail() {
  echo
  echo "  $1"
  [[ -n ${2:-} ]] && echo "  $2"
  echo
  if (( HOLD )); then
    echo "  Press any key to close."
    # Read from the controlling terminal rather than stdin: the launched window
    # inherits an already-closed stdin, so a plain `read` sees EOF and returns
    # instantly, which is exactly the flash this is here to prevent.
    read -rsn1 </dev/tty 2>/dev/null || sleep 15
  fi
  return_focus
  exit 1
}

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  bail "Not a git repository:" "$PWD"
fi

# With no revision given, giff runs a plain `git diff` — unstaged tracked
# changes only. That reports "No changes." when everything is staged, which in
# the floating window just looks like it failed to open. `giff HEAD` covers
# staged and unstaged together, which is what "show me my changes" usually
# means, and giff labels the panes HEAD → Working Tree either way.
if (( $# == 0 )); then
  if [[ -n $(git diff HEAD --no-color 2>/dev/null) ]]; then
    set -- HEAD
  else
    untracked=$(git ls-files --others --exclude-standard | wc -l)
    if (( untracked > 0 )); then
      bail "No tracked changes to diff." \
           "$untracked untracked file(s) — git diff never shows those. Add them first."
    fi
    bail "No changes since the last commit."
  fi
fi

# Hyprland maps the window at the terminal's default size (80x24 for foot) and
# only then applies the size rule. giff draws its first frame immediately and
# then blocks in event::read(), so it would sit showing an 80-column layout in a
# 127-column window until the next key or mouse event woke it. Waiting for the
# grid to stop changing means the first frame is already the right size. Same
# approach omarchy-launch-about uses before it measures itself.
settle_grid() {
  local current previous="" held=0
  for _ in {1..40}; do
    current=$(stty size 2>/dev/null) || return 0
    if [[ $current == $previous ]]; then
      (( ++held == 3 )) && return 0
    else
      held=0
      previous=$current
    fi
    sleep 0.05
  done
}

(( HOLD )) && settle_grid

# Not exec: giff has to return so focus can be handed back afterwards.
giff "$@"
status=$?
return_focus
exit $status
