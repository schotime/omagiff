#!/bin/bash
# Open giff in its own window (app-id TUI.giff), shaped to suit the layout of
# the workspace it lands on.
#
#   scrolling  -> tiled, resized to a full-width column
#   otherwise  -> a centred float at 90% of the monitor
#
# The whole rule is created here rather than in hyprland.lua so there is one
# source of truth per launch, instead of a static rule that the scrolling case
# would then have to fight.

for required in omarchy-launch-tui omagiff-run; do
  if ! command -v "$required" >/dev/null 2>&1; then
    echo "omagiff: $required not found on PATH" >&2
    exit 1
  fi
done

# Shape can be forced, for when the workspace layout is not what you want this
# particular window to follow. Consumed here so the rest is passed to giff.
mode=auto
while :; do
  case "${1:-}" in
    --float) mode=float; shift ;;
    --tile | --wide) mode=tile; shift ;;
    --auto) mode=auto; shift ;;
    *) break ;;
  esac
done

layout=""
if [[ $mode == auto ]]; then
  command -v jq >/dev/null 2>&1 &&
    layout=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.tiledLayout // empty' 2>/dev/null)
else
  layout=$([[ $mode == tile ]] && echo scrolling || echo forced-float)
fi

# Captured before launching, while the terminal you typed this in still holds
# focus, so it can be focused again once giff's window is gone.
return_to=""
command -v jq >/dev/null 2>&1 &&
  return_to=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty' 2>/dev/null)

# Refocusing has to happen after giff's window has actually disappeared. Doing
# it from inside that window (as omagiff-run once did) means focusing the
# launcher and then having Hyprland re-pick focus when the window closes a
# moment later. Watching from out here avoids that race entirely.
#
# The scrolling layout only scrolls to a newly focused window when at least
# scrolling:follow_min_visible of it is already on screen (0.4 by default), and
# a full-width column pushes the launcher well under that, so the threshold is
# dropped for this one dispatch and put straight back.
watch_and_restore() {
  local want_full="$1" address="" threshold=""

  # Identify our window by waiting for a FOCUSED one, and take that address.
  # Looking up "the first TUI.giff" instead picks a stale window from an earlier
  # session, and then nothing below ever matches.
  for _ in {1..80}; do
    address=$(hyprctl activewindow -j 2>/dev/null |
      jq -r 'select(.class == "TUI.giff") | .address // empty' 2>/dev/null)
    [[ -n $address ]] && break
    sleep 0.1
  done
  [[ -n $address ]] || return 0

  # colresize acts on the focused column, which is ours as of the loop above.
  # It is a scrolling-layout message; on dwindle it is simply rejected.
  [[ $want_full == full ]] && hyprctl dispatch 'hl.dsp.layout("colresize 1.0")' >/dev/null 2>&1

  [[ -n $return_to ]] || return 0

  while hyprctl clients -j 2>/dev/null | jq -e --arg a "$address" 'any(.[]; .address == $a)' >/dev/null 2>&1; do
    sleep 0.4
  done

  threshold=$(hyprctl getoption scrolling:follow_min_visible 2>/dev/null | awk '/^float:/ {print $2}')
  [[ $threshold =~ ^[0-9.]+$ ]] && hyprctl keyword scrolling:follow_min_visible 0 >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$return_to\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$return_to" >/dev/null 2>&1 || true
  [[ $threshold =~ ^[0-9.]+$ ]] && hyprctl keyword scrolling:follow_min_visible "$threshold" >/dev/null 2>&1
  return 0
}

apply_rule() {
  # Replacing the previous launch's rule keeps a float rule from outliving the
  # workspace it was made for. A Hyprland without the Lua eval API just skips
  # this and gets the layout's normal placement.
  hyprctl eval "
    if omagiff_rule then omagiff_rule:set_enabled(false) end
    omagiff_rule = hl.window_rule({ match = { class = 'TUI.giff' }, $1 })" >/dev/null 2>&1
}

if [[ $layout == scrolling ]]; then
  apply_rule "tile = true"

  watch_and_restore full >/dev/null 2>&1 &
  disown 2>/dev/null || true
else
  # Window-rule sizes are pixels, not percentages, so 90% is computed against
  # the focused monitor's LOGICAL size (physical / scale). Same approach
  # omarchy-launch-about uses to presize itself, and recomputing it per launch
  # keeps it right across monitors with different resolutions or scales.
  size=""
  if [[ -n $layout ]]; then
    read -r width height <<<"$(
      hyprctl monitors -j 2>/dev/null |
        jq -r 'first(.[] | select(.focused)) | "\(.width / .scale | floor) \(.height / .scale | floor)"' 2>/dev/null
    )"
    [[ $width =~ ^[0-9]+$ && $height =~ ^[0-9]+$ ]] &&
      size=", size = { $((width * 90 / 100)), $((height * 90 / 100)) }"
  fi
  apply_rule "float = true, center = true$size"

  watch_and_restore plain >/dev/null 2>&1 &
  disown 2>/dev/null || true
fi

# The detached terminal inherits this shell's stdout/stderr, so foot's startup
# chatter ("compositor does not implement the xdg-toplevel-icon protocol") lands
# in the prompt you launched from. Real problems are caught above, so the
# terminal's own output is discarded rather than left to litter the shell.
exec omarchy-launch-tui --app-id=TUI.giff omagiff-run --omagiff-window "$@" >/dev/null 2>&1
